# Copy this file to .env and fill in your values

PORT=4000

# ESP32-CAM control server (not the main robot controller or video port).
ESP32_CAM_BASE_URL=http://192.168.1.10

# MQTT broker the ESP32 unit(s) and this server both connect to.
# For a first test you can use a free public broker like:
#   mqtt://broker.hivemq.com:1883
# For a real deployment, run your own (Mosquitto) on a Pi or small VPS
# so the system still works if the internet drops during a disaster.
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Comma-separated list of unit IDs you expect to hear from.
# Each ESP32 publishes under resqx/<UNIT_ID>/...
RESQX_UNIT_IDS=unit-01

# Allow the frontend dev server to connect (Vite default port)
CORS_ORIGIN=http://localhost:5173

# --- Optional: real alert delivery (leave blank to just log alerts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=
