# Copy this file to .env and fill in your values

PORT=4000
NODE_ENV=development

# ESP32-CAM control server (not the main robot controller or video port).
ESP32_CAM_BASE_URL=http://CAMERA_HOST_OR_IP

# MQTT broker the ESP32 unit(s) and this server both connect to.
# Use mqtt:// for a local trusted broker or mqtts:// for TLS.
MQTT_BROKER_URL=mqtt://BROKER_HOST:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# Comma-separated list of unit IDs you expect to hear from.
# Each ESP32 publishes under resqx/<UNIT_ID>/...
RESQX_UNIT_IDS=unit-01
# Dashboard unit controlled by the dedicated motor ESP32.
RESQX_MOTOR_UNIT_ID=unit-01
# Keep false for real hardware. The root one-command dev stack overrides this
# to true so it can never publish to the physical motor command topic.
RESQX_SIMULATION_MODE=false

# Allow the frontend dev server to connect (Vite default port)
CORS_ORIGIN=http://localhost:5173

# When enabled, startup prints a random local dashboard link that creates a
# protected browser session without showing a username/password page.
RESQX_LOCAL_DASHBOARD_ACCESS=false

# Create the first account with `npm.cmd run init-admin -- <username>`.
# Do not put real passwords in this file or commit a populated .env.
# INITIAL_ADMIN_USERNAME=
# INITIAL_ADMIN_PASSWORD=

# --- Optional: real alert delivery (leave blank to just log alerts) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_SMS_TO=
